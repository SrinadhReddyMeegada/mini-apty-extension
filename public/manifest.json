{
  "manifest_version": 3,
  "name": "Mini Apty",
  "version": "0.1.0",
  "description": "Author and replay in-app walkthroughs on any website",

  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Mini Apty"
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ]
}
